# JioMart bot (bot-v2) configuration — copy to .env and fill in your own values.
# Never commit a real .env: it holds your Telegram bot token.

# Telegram bot token from @BotFather, and your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delivery pincode the bot scans for
JIOMART_PINCODE=560045

# Optional: scan several pincodes in one run (comma-separated). Prices
# differ by dark store, so each pincode is scanned and diffed on its own
# history; the same flag works on the command line: --pincode 560045 --pincode 110001
# JIOMART_PINCODES=560045,110001

# Only alert deals at or above this discount %
MIN_DISCOUNT=50

# Max deals fetched per category per run
DEAL_LIMIT=20

# Optional: your own JioMart session bearer token, copied from your browser's
# DevTools Network tab (any jiomart.com API request -> Authorization header).
# Leave blank to try without one; if JioMart answers 401/403, fill this in.
# It expires when your browser session does — refresh it when alerts stop.
JIOMART_BEARER=

# Optional: SQLite file location (default: bot-v2/jiomart_bot.db)
# DB_PATH=jiomart_bot.db

# Optional: port for the health-check server (only used when set, e.g. on Render)
# PORT=10000
